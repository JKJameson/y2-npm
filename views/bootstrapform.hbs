<link rel="stylesheet" href="/css/bootstrap-page.css">
<main>

    <section class="content">
    
        <h1>Holiday Booking Form with bootstrap</h1>

        <form action="#" method="get">

        <!-- Input Box -->
        <div>
            <label for="name" class="form-label">Full Name:</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="Enter your full name">
        </div>

        <!-- Password -->
        <div>
            <label for="password" class="form-label">Account Password:</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password">
        </div>
        <!-- Text Area -->
        <div>
            <label for="comments" class="form-label">Special Requests:</label>
            <textarea id="comments" name="comments" rows="4" cols="40" class="form-control" placeholder="Enter your special requests"></textarea>
        </div>
        <!-- Checkboxes -->
        <fieldset>
            <legend>Extras</legend>

            <input type="checkbox" id="breakfast" name="extras" value="Breakfast">
            <label for="breakfast" class="form-label">Breakfast Included</label>

            <input type="checkbox" id="parking" name="extras" value="Parking">
            <label for="parking">Parking Space</label>
        </fieldset>

        <!-- Radio Buttons -->
        <fieldset>
            <legend>Room Type</legend>

            <input type="radio" id="single" name="room" value="Single">
            <label for="single" class="form-label">Single Room</label>

            <input type="radio" id="double" name="room" value="Double">
            <label for="double" class="form-label">Double Room</label>

            <input type="radio" id="family" name="room" value="Family">
            <label for="family" class="form-label">Family Room</label>
        </fieldset>

        <!-- Select -->
        <div>
            <label for="destination"  class="form-label">Destination:</label>
            <select id="destination" name="destination" class="form-control">
            <option value="">Choose a destination</option>
            <option value="sligo">Sligo</option>
            <option value="galway">Galway</option>
            <option value="cork">Cork</option>
            <option value="dublin">Dublin</option>
            </select>
        </div>


            <!-- Multiple Select -->
            <div>
            <label for="activities" class="form-label">Activities (hold Ctrl/Cmd to select multiple):</label>
            <select id="activities" name="activities" multiple size="4"  class="form-control">
                <option value="hiking">Hiking</option>
                <option value="surfing">Surfing</option>
                <option value="cycling">Cycling</option>
                <option value="boat-trip">Boat Trip</option>
            </select>
            </div>

            <!-- Submit Button -->
            <input type="submit" value="Book Holiday" class="btn btn-primary mt-3">

        </form>
    </section>
</main>