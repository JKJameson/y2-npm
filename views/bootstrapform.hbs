    <style>
        form {
            width: min(100%, 600px);
            margin: 0 auto;
            padding: 1rem;
            box-sizing: border-box;
            }

    </style>
    
    <h1>Holiday Booking Form without bootstrap</h1>

    <form action="#" method="get">

      <!-- Input Box -->
      <div>
        <label for="name">Full Name:</label>
        <input type="text" id="name" name="name">
      </div>

      <!-- Password -->
      <div>
        <label for="password">Account Password:</label>
        <input type="password" id="password" name="password">
      </div>
      <!-- Text Area -->
      <div>
        <label for="comments">Special Requests:</label>
        <textarea id="comments" name="comments" rows="4" cols="40"></textarea>
      </div>
      <!-- Checkboxes -->
      <fieldset>
        <legend>Extras</legend>

        <input type="checkbox" id="breakfast" name="extras" value="Breakfast">
        <label for="breakfast">Breakfast Included</label>

        <input type="checkbox" id="parking" name="extras" value="Parking">
        <label for="parking">Parking Space</label>
      </fieldset>

      <!-- Radio Buttons -->
      <fieldset>
        <legend>Room Type</legend>

        <input type="radio" id="single" name="room" value="Single">
        <label for="single">Single Room</label>

        <input type="radio" id="double" name="room" value="Double">
        <label for="double">Double Room</label>

        <input type="radio" id="family" name="room" value="Family">
        <label for="family">Family Room</label>
      </fieldset>

      <!-- Select -->
      <div>
        <label for="destination">Destination:</label>
        <select id="destination" name="destination">
          <option value="">Choose a destination</option>
          <option value="sligo">Sligo</option>
          <option value="galway">Galway</option>
          <option value="cork">Cork</option>
          <option value="dublin">Dublin</option>
        </select>
       </div>


        <!-- Multiple Select -->
        <div>
          <label for="activities">Activities (hold Ctrl/Cmd to select multiple):</label>
          <select id="activities" name="activities" multiple size="4">
            <option value="hiking">Hiking</option>
            <option value="surfing">Surfing</option>
            <option value="cycling">Cycling</option>
            <option value="boat-trip">Boat Trip</option>
          </select>
        </div>

        <!-- Submit Button -->
        <input type="submit" value="Book Holiday">

    </form>
