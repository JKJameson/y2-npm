<link rel="stylesheet" href="/css/bootstrap-page.css">
<main>

    <section class="content">
    
        <h1>Holiday Booking Form with bootstrap</h1>

        <form action="#" method="get">

        <!-- Input Box -->
        <div class="form-floating mb-3">
            <!-- input must come before label for floating labels to work -->
            <input type="text" id="name" name="name" class="form-control" placeholder="Enter your full name">
            <label for="name" class="form-label">Full Name</label>
            <p class="form-text alert alert-warning" id="nameHelp">Please use the name on your passport or driving licence</p>
        </div>

        <!-- Password -->
        <div class="mb-3">
            <label for="password" class="form-label">Account Password:</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password">
        </div>
        <!-- Text Area -->
        <div class="mb-3">
            <label for="comments" class="form-label">Special Requests:</label>
            <textarea id="comments" name="comments" rows="4" cols="40" class="form-control-plaintext" placeholder="Enter your special requests" disabled></textarea>
        </div>
        <!-- Checkboxes -->
        <fieldset class="mb-3">
            <legend>Extras</legend>

            <div class="form-check mb-3">
                <input type="checkbox" id="breakfast" name="extras" value="Breakfast" class="form-check-input">
                <label for="breakfast" class="form-label" class="form-check-label">Breakfast Included</label>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" id="parking" name="extras" value="Parking" class="form-check-input">
                <label for="parking" class="form-check-label">Parking Space</label>
            </div>
        </fieldset>

        <!-- Radio Buttons -->
        <fieldset class="mb-3">
            <legend>Room Type</legend>

            <div class="form-check mb-3">
                <input type="radio" id="single" name="room" value="Single" class="form-check-input">
                <label for="single" class="form-check-label">Single Room</label>
            </div>

            <div class="form-check mb-3">
                <input type="radio" id="double" name="room" value="Double" class="form-check-input">
                <label for="double" class="form-check-label">Double Room</label>
            </div>

            <div class="form-check mb-3">
                <input type="radio" id="family" name="room" value="Family" class="form-check-input">
                <label for="family" class="form-check-label">Family Room</label>
            </div>
        </fieldset>

        <!-- Select -->
        <div class="mb-3">
            <label for="destination"  class="form-label">Destination:</label>
            <select id="destination" name="destination" class="form-control">
            <option value="">Choose a destination</option>
            <option value="sligo">Sligo</option>
            <option value="galway">Galway</option>
            <option value="cork">Cork</option>
            <option value="dublin">Dublin</option>
            </select>
        </div>


            <!-- Multiple Select -->
            <div class="mb-3">
            <label for="activities" class="form-label">Activities (hold Ctrl/Cmd to select multiple):</label>
            <select id="activities" name="activities" multiple size="4"  class="form-select">
                <option value="hiking">Hiking</option>
                <option value="surfing">Surfing</option>
                <option value="cycling">Cycling</option>
                <option value="boat-trip">Boat Trip</option>
            </select>
            </div>

            <!-- Submit Button -->
            <input type="submit" value="Book Holiday" class="btn btn-primary mt-3">

        </form>
    </section>
</main>